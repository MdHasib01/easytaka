# VITE_API_URL: Base path the browser calls for the EasyTaka API.
# Leave as "/api" to go through the Vite dev proxy (same-origin, no CORS).
# Set to a full URL (e.g. https://api.easytaka.com/api) for a deployed build.
VITE_API_URL="/api"

# VITE_PROXY_TARGET: Where the Vite dev proxy forwards /api requests.
# Must match the PORT in server/.env.
VITE_PROXY_TARGET="http://localhost:5000"
